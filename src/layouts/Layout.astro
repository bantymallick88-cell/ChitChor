---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "ChitChor — Play Raja Rani Chor Police Online (Free Paper Chit Game)",
  description = "Play the iconic Indian royal paper chit game Raja Rani Chor Police online with friends or pass & play offline on any device. 3D folded paper chits, automated scoring, 4 & 5 player modes. Zero login required.",
  keywords = "ChitChor, Raja Rani Chor Police online game, Chor Sipahi paper game, 4 player paper chit game, Indian party board games online, Raja Mantri Chor Sipahi, Raja Wazir Chor Sipahi, pass and play parlour game",
  canonicalUrl = "https://chitchor.fixeehub.com/",
  ogImage = "https://chitchor.fixeehub.com/og-image.svg",
} = Astro.props;

const jsonLdData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://chitchor.fixeehub.com/#website",
      "url": "https://chitchor.fixeehub.com/",
      "name": "ChitChor",
      "alternateName": [
        "Chit Chor",
        "Raja Rani Chor Police Online",
        "Raja Rani Chor Sipahi Game",
        "Raja Mantri Chor Sipahi Online"
      ],
      "description": "Play the modern royal Indian paper chit game Raja Rani Chor Police online with friends or pass & play offline.",
      "publisher": {
        "@type": "Organization",
        "name": "FixeeHub",
        "url": "https://fixeehub.com",
        "logo": "https://chitchor.fixeehub.com/favicon.svg"
      }
    },
    {
      "@type": "VideoGame",
      "@id": "https://chitchor.fixeehub.com/#game",
      "name": "ChitChor — Raja Rani Chor Police Online",
      "url": "https://chitchor.fixeehub.com/",
      "description": "The modern royal 3D paper chit parlour game. Draw secret chits for Raja, Rani, Katual, Sipahi, and Chor. Automated scoring, multiplayer rooms, and pass & play mode.",
      "genre": ["Party Game", "Board Game", "Social Deduction", "Multiplayer Game"],
      "gamePlatform": ["Web Browser", "PWA", "Mobile Web", "Desktop Web", "iOS", "Android"],
      "applicationCategory": "Game",
      "operatingSystem": "Any",
      "inLanguage": ["en", "hi"],
      "numberOfPlayers": {
        "@type": "QuantitativeValue",
        "minValue": 4,
        "maxValue": 5
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "1280",
        "bestRating": "5"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="FixeeHub" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Mobile PWA Meta -->
    <meta name="theme-color" content="#0a0d14" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ChitChor" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ChitChor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ChitChor - Raja Rani Chor Police Online Game Preview" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts for Luxury Royal Serif Heading & Clean UI -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Structured Data JSON-LD for High Google Ranking -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />

    <style>
      .font-serif {
        font-family: 'Cinzel', serif, Georgia, Cambria, 'Times New Roman', Times;
      }
      body {
        font-family: 'Outfit', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#0b0f19] text-slate-100 min-h-screen overflow-x-hidden flex flex-col">
    <slot />

    <!-- Service Worker Registration for PWA Zero-Install -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then(
            (reg) => {
              console.log('ChitChor PWA ServiceWorker registered with scope:', reg.scope);
            },
            (err) => {
              console.log('ChitChor PWA ServiceWorker registration failed:', err);
            }
          );
        });
      }
    </script>
  </body>
</html>
